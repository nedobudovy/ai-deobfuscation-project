+    def is_param_void(self, param: Node) -> bool:
+        """Return whether an unnamed (Typename) parameter is of type `void`,
+        unwrapping pointers/arrays first (mirrors the IdentifierType checks
+        used elsewhere in this file)."""
+        node = param.type
+        while isinstance(node, (PtrDecl, ArrayDecl)):
+            node = node.type
+        return (
+            isinstance(node, TypeDecl)
+            and isinstance(node.type, IdentifierType)
+            and len(node.type.names) > 0
+            and node.type.names[0] == "void"
+        )
